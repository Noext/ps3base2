# Everything below is derived from the user's own disc or firmware and is never
# tracked. The pre-commit hook refuses binaries; this list keeps them out of
# the index in the first place.
# Derived game sources, one tree per title. "out-GTA" used to slip past this
# rule: the pattern was anchored and named only the default directory, so a
# second title's lifted code (22 MB of generated C++) showed up as untracked.
/out/
/out-*/
/bin/
/fw/
/keys/
/ref/
/user/
/blackbox/
/build*/
/dlss/
*.elf
*.sprx
*.prx
*.self
*.SELF
*.pkg
*.pup

# Run artefacts: SPU local-store dumps, logs, captures, scratch scripts.
*.ls
gowa.log
trace.bin
frames.bin
/spucap/
*.ppm
/refs
/surface_*.ppm

# Shader cache: .spv files are the game's own RSX shaders compiled from the
# disc, and pipelines.bin is the Vulkan pipeline cache built from them. Both are
# derived from the game, both are regenerated on demand, and neither belongs in
# git. They were tracked once, before this rule existed; the history purge is
# what removed them.
shader_cache/
*.spv

# Debug artefacts written by the runtime's diagnostic env vars. They are
# regeneration products, not sources.
*.glsl
*.pgm
*.ppm
surface_*.ppm
teximg_*.ppm
glyphsrc_*.raw
snap_*.bin
pair_*.raw
framelog*

# One-off scratch scripts from a single debugging session. They carry absolute
# host paths (/root/Dev/...), reference nothing in the tree, and describe the
# state of one file at one moment rather than a job anything can re-run.
/de*.py
/hooks.py
/excl.py
/spu.py
/mkstubs*.py


# Python bytecode: a build artefact, and it embeds the absolute paths of the
# machine that produced it.
__pycache__/
*.pyc


# Firmware extracted from a PUP. The PUP itself and everything inside it is
# Sony's; this tree only ever carries the modules already decrypted into fw/.
/fw-src/


# Generated at run time by the title, never a source file.
/vfs/dev_hdd1/
